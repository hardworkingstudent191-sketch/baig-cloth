# Which backend this build talks to — the two are interchangeable:
#   FastAPI (local dev):    http://localhost:8000
#   WordPress (production): https://cms.yourdomain.com/wp-json/baig/v1
VITE_API_URL=http://localhost:8000

# Production builds REFUSE a localhost / plain-http VITE_API_URL (it would ship
# fine, then fail for every visitor). Vite reads frontend/.env.local in
# production mode too, so a leftover dev override there is caught as well.
# For a local `vite preview` smoke test only, set VITE_ALLOW_LOCAL_API=1.

# The React admin panel (/admin) only works with the FastAPI backend. It is
# mounted automatically unless VITE_API_URL contains "/wp-json/" (WordPress
# is managed in wp-admin). Force either way with VITE_ADMIN_ENABLED=true|false.

# Public origin of the deployed storefront, no trailing slash.
# Feeds the absolute Open Graph URLs in index.html plus the generated
# robots.txt and sitemap.xml (see vite.config.ts). MUST be set for the
# production build or shared links get broken preview images — the build
# prints a warning if it's missing.
VITE_SITE_URL=https://baigcloth.com
