VITE_API_URL=http://localhost:8000

# Public origin of the deployed storefront, no trailing slash.
# Feeds the absolute Open Graph URLs in index.html plus the generated
# robots.txt and sitemap.xml (see vite.config.ts). MUST be set for the
# production build or shared links get broken preview images — the build
# prints a warning if it's missing.
VITE_SITE_URL=https://baigcloth.com
