# Database
DATABASE_URL=postgresql://user:password@localhost:5432/baigcloth

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Initial admin (used only by scripts/create_admin.py)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-password

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://baigcloth.com
