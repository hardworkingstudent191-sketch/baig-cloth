# Database
DATABASE_URL=postgresql://user:password@localhost:5432/baigcloth

# JWT
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
# The app will refuse to start if this is left as the placeholder below, or
# if it's under 32 characters — a weak or default secret would let anyone
# who has seen it forge admin logins.
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Initial admin (used only by scripts/create_admin.py)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-password

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://baigcloth.com

# Reverse proxies between the internet and this process (each appends one
# X-Forwarded-For entry). 1 = Koyeb's edge proxy (production). 0 = running
# directly with no proxy (local dev) — the header is then ignored entirely
# because every entry in it is client-supplied. See app/rate_limit.py.
TRUSTED_PROXY_HOPS=1
